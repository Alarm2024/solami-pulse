# solami-pulse — copy to .env and fill in. Never commit .env.

# Solami (https://solami.dev). One key serves Blur, RPC and WebSocket.
SOLAMI_API_KEY=
# Optional overrides (defaults shown)
# SOLAMI_BLUR_URL=wss://ws.solami.dev/data/subscribe
# SOLAMI_RPC_URL=https://rpc.solami.dev/sol
# SOLAMI_WS_URL=wss://ws.solami.dev/ws/sol
# Sent to Blur after the socket opens. {} = everything; backfill replays recent events (de-duplicated).
BLUR_SUBSCRIBE={"backfill":30}

# RPC Fast (https://rpcfast.com) — paste your Solana mainnet endpoint (Frankfurt) from the RPC Fast dashboard.
RPCFAST_URL=
# Leave empty to derive it from RPCFAST_URL (https -> wss).
RPCFAST_WS_URL=

# Which provider serves RPC calls (on-chain verification of sampled Blur events): solami or rpcfast.
RPC_PROVIDER=solami
VERIFY_PER_MINUTE=12

# Alerts: rules file, and an optional URL of your own that receives each alert as a JSON POST.
ALERT_RULES_FILE=alerts.example.json
ALERT_WEBHOOK_URL=

# Dashboard
HOST=127.0.0.1
PORT=8787
DATA_DIR=data
